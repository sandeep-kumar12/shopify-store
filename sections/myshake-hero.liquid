<div
  class="hero-myshake color-{{ section.settings.color_scheme }}"
  id="hero-myshake-{{ section.id }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  data-slide-count="{{ section.blocks.size }}"
>

  {%- for block in section.blocks -%}
    <div
      class="hero-myshake__wrap{% if forloop.first %} is-active{% endif %}"
      data-slide-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >

      <div class="hero-myshake__bg">
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 2400 }}"
            srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w,
                    {{ block.settings.image | image_url: width: 1800 }} 1800w,
                    {{ block.settings.image | image_url: width: 2400 }} 2400w"
            sizes="100vw"
            alt="{{ block.settings.image.alt | default: 'MyShake' | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- else -%}
          {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="hero-myshake__content">

        <div class="hero-myshake__top">
          <p>{{ block.settings.text_top_line1 }}</p>
          <p>{{ block.settings.text_top_line2 }}</p>
        </div>

        <div class="hero-myshake__bar">
          <div class="hero-myshake__bar-left">
            <div class="hero-myshake__eyebrow">
              <span class="hero-myshake__eyebrow-rule"></span>
              <span class="hero-myshake__eyebrow-text">
                <span class="label">{{ block.settings.eyebrow_label }}</span>
                <span class="sub">{{ block.settings.eyebrow_sub }}</span>
              </span>
            </div>
            <div class="hero-myshake__live">{{ block.settings.heading_live }}</div>
          </div>
          <div class="hero-myshake__perform">{{ block.settings.heading_perform }}</div>
        </div>

        <div class="hero-myshake__bottom">
          <p>{{ block.settings.text_bottom }}</p>
        </div>

      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="hero-myshake__pagination">
      <div class="hero-myshake__pagination-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="hero-myshake__pagination-fill"></span>
      </div>
    </div>
  {%- endif -%}

</div>

<style>
  #shopify-section-{{ section.id }} .hero-myshake {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: {{ section.settings.aspect_desktop }};
  }

  #shopify-section-{{ section.id }} .hero-myshake__wrap {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hero-myshake__wrap.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .hero-myshake__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .hero-myshake__bg img,
  #shopify-section-{{ section.id }} .hero-myshake__bg .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-myshake__content {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .hero-myshake__top,
  #shopify-section-{{ section.id }} .hero-myshake__bottom {
    position: absolute;
    right: 20%;
    text-align: left;
    max-width: 60%;
  }
  #shopify-section-{{ section.id }} .hero-myshake__top { top: 30%; }
  #shopify-section-{{ section.id }} .hero-myshake__bottom { top: 68%; }

  #shopify-section-{{ section.id }} .hero-myshake__top p,
  #shopify-section-{{ section.id }} .hero-myshake__bottom p {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: clamp(14px, 4vw, 60px);
    line-height: 1.3;
    color: {{ section.settings.color_white }};
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hero-myshake__bar {
    position: absolute;
    left: 0;
    top: 50.5%;
    width: 100%;
    height: 14%;
    display: flex;
    align-items: stretch;
    background: {{ section.settings.color_teal }};
  }

  #shopify-section-{{ section.id }} .hero-myshake__bar-left {
    display: flex;
    align-items: stretch;
    flex: 0 0 55%;
    max-width: 55%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .hero-myshake__eyebrow {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1vw, 30px);
    white-space: nowrap;
    flex: 0 0 auto;
    margin: auto;
  }
  #shopify-section-{{ section.id }} .hero-myshake__eyebrow-rule {
    width: 1px;
    align-self: stretch;
    background: {{ section.settings.color_green }};
    opacity: 0.6;
  }
  #shopify-section-{{ section.id }} .hero-myshake__eyebrow-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    color: {{ section.settings.color_white }};
  }
  #shopify-section-{{ section.id }} .hero-myshake__eyebrow-text .label {
    font-weight: 500;
    font-size: clamp(8px, 0.85vw, 16px);
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .hero-myshake__eyebrow-text .sub {
    font-weight: 400;
    font-size: clamp(7px, 0.75vw, 14px);
    margin-top: 2px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .hero-myshake__live {
    display: flex;
    align-items: center;
    padding: 0 clamp(8px, 1.5vw, 22px);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: clamp(13px, 4.8vw, 70px);
    color: {{ section.settings.color_green }};
    white-space: nowrap;
    flex: 0 0 auto;
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .hero-myshake__perform {
    display: flex;
    align-items: center;
    flex: 0 0 45%;
    max-width: 45%;
    min-width: 0;
    background: {{ section.settings.color_green }};
    color: {{ section.settings.color_teal }};
    padding-left: clamp(10px, 1vw, 32px);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: clamp(13px, 4.8vw, 70px);
    white-space: nowrap;
    overflow: hidden;
  }

  /* Progress: fills only the active slide's segment (not a continuous loop) */
  #shopify-section-{{ section.id }} .hero-myshake__pagination {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    z-index: 3;
  }
  #shopify-section-{{ section.id }} .hero-myshake__pagination-track {
    position: relative;
    width: 64px;
    height: 5px;
    background: rgba(255, 255, 255, 0.35);
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .hero-myshake__pagination-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: {{ section.settings.color_green }};
    border-radius: 2px;
    will-change: width;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .hero-myshake { aspect-ratio: {{ section.settings.aspect_mobile }}; }
    #shopify-section-{{ section.id }} .hero-myshake__top { top: 51%; }
    #shopify-section-{{ section.id }} .hero-myshake__bottom { top: 70%; }
    #shopify-section-{{ section.id }} .hero-myshake__bar { top: 60%; height: 10%; }
    #shopify-section-{{ section.id }} .hero-myshake__pagination-track { width: 60px; }
  }
</style>

{%- if section.blocks.size > 1 -%}
<script>
  (function () {
    var root = document.getElementById('hero-myshake-{{ section.id }}');
    if (!root) return;

    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-myshake__wrap'));
    var track = root.querySelector('.hero-myshake__pagination-track');
    var fill = track ? track.querySelector('.hero-myshake__pagination-fill') : null;
    var speed = parseFloat(root.dataset.autoplaySpeed || '5');
    var total = slides.length;
    if (total < 2) return;

    var current = 0;
    var timer = null;

    function segmentStart(index) {
      return (index / total) * 100;
    }

    function segmentEnd(index) {
      return ((index + 1) / total) * 100;
    }

    function setFillInstant(percent) {
      if (!fill) return;
      fill.style.transition = 'none';
      fill.style.width = percent + '%';
      void fill.offsetWidth;
    }

    function animateFill(fromPercent, toPercent) {
      if (!fill) return;
      setFillInstant(fromPercent);
      fill.style.transition = 'width linear ' + speed + 's';
      fill.style.width = toPercent + '%';
      if (track) track.setAttribute('aria-valuenow', String(Math.round(toPercent)));
    }

    function runSlide(index) {
      slides[current].classList.remove('is-active');
      current = ((index % total) + total) % total;
      slides[current].classList.add('is-active');

      // Active slide ke hisaab se sirf uska segment fill hota hai
      // Example: 2 slides → slide 0: 0→50%, slide 1: 50→100%, phir reset
      var from = segmentStart(current);
      var to = segmentEnd(current);

      // Loop back to first slide: pehle 0 pe jump, phir animate
      if (current === 0) {
        setFillInstant(0);
      }

      animateFill(from, to);

      clearTimeout(timer);
      timer = setTimeout(function () {
        runSlide(current + 1);
      }, speed * 1000);
    }

    if (track) {
      track.addEventListener('click', function () {
        clearTimeout(timer);
        runSlide(current + 1);
      });
    }

    // Pehli active image ke liye progress start
    requestAnimationFrame(function () {
      runSlide(0);
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "MyShake Hero",
  "settings": [
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed (seconds)", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_teal", "label": "Teal", "default": "#105254" },
    { "type": "color", "id": "color_green", "label": "Green", "default": "#A5ED64" },
    { "type": "color", "id": "color_white", "label": "White / text", "default": "#FFFFFF" },
    { "type": "header", "content": "Aspect ratios" },
    { "type": "text", "id": "aspect_desktop", "label": "Desktop aspect ratio", "default": "1442 / 753" },
    { "type": "text", "id": "aspect_tablet", "label": "Tablet aspect ratio", "default": "3 / 2" },
    { "type": "text", "id": "aspect_mobile", "label": "Mobile aspect ratio", "default": "4 / 5" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "header", "content": "Top text" },
        { "type": "text", "id": "text_top_line1", "label": "Top line 1", "default": "Nutrition" },
        { "type": "text", "id": "text_top_line2", "label": "Top line 2", "default": "that's made" },
        { "type": "header", "content": "Colored bar" },
        { "type": "text", "id": "eyebrow_label", "label": "Eyebrow label", "default": "Performance Focused" },
        { "type": "text", "id": "eyebrow_sub", "label": "Eyebrow sub label", "default": "Sports Nutrition Brand" },
        { "type": "text", "id": "heading_live", "label": "Bar heading (green text)", "default": "Live" },
        { "type": "text", "id": "heading_perform", "label": "Bar heading (green block)", "default": "to Perform" },
        { "type": "header", "content": "Bottom text" },
        { "type": "text", "id": "text_bottom", "label": "Bottom line", "default": "not bulk up." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MyShake Hero",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
