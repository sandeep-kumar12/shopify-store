<footer
  class="myshake-footer"
  id="myshake-footer-{{ section.id }}"
  style="
    --mf-bg: {{ section.settings.bg_color }};
    --mf-accent: {{ section.settings.accent_color }};
    --mf-bolt: {{ section.settings.bolt_color }};
    --mf-text: {{ section.settings.text_color }};
    --mf-mid-pad-l: {{ section.settings.mid_padding_left }}px;
    --mf-mid-pad-r: {{ section.settings.mid_padding_right }}px;
    --mf-bot-pad-l: {{ section.settings.bottom_padding_left }}px;
    --mf-bot-pad-r: {{ section.settings.bottom_padding_right }}px;
  "
>
  {%- comment -%} TOP: page-width left/right {%- endcomment -%}
  <div class="myshake-footer__top page-width">
    <div class="myshake-footer__brand">
      <div class="myshake-footer__bolt">
        {%- if section.settings.bolt_icon != blank -%}
          <img
            src="{{ section.settings.bolt_icon | image_url: width: 90 }}"
            alt=""
            loading="lazy"
            width="{{ section.settings.bolt_icon.width }}"
            height="{{ section.settings.bolt_icon.height }}"
          >
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" fill="currentColor"/>
          </svg>
        {%- endif -%}
      </div>

      {%- if section.settings.social_x != blank or section.settings.social_instagram != blank or section.settings.social_youtube != blank or section.settings.social_linkedin != blank -%}
        <ul class="myshake-footer__social" role="list">
          {%- if section.settings.social_x != blank -%}
            <li>
              <a href="{{ section.settings.social_x }}" aria-label="X" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.53 3H21l-7.36 8.41L22.2 21h-6.77l-5.3-6.53L4.02 21H.55l7.87-8.99L1 3h6.94l4.79 5.97L17.53 3Zm-1.19 16.17h1.87L7.75 4.73H5.74l10.6 14.44Z" fill="currentColor"/></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_instagram != blank -%}
            <li>
              <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"/></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <li>
              <a href="{{ section.settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 9.3v5.4l4.7-2.7-4.7-2.7Z" fill="currentColor"/></svg>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_linkedin != blank -%}
            <li>
              <a href="{{ section.settings.social_linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M7.6 10.2v6.4M7.6 7.6v.02M11.4 16.6v-3.7c0-1.2.8-1.9 1.9-1.9 1 0 1.7.7 1.7 1.9v3.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <div class="myshake-footer__legal">
        {%- if section.settings.fssai_text != blank -%}<p>{{ section.settings.fssai_text }}</p>{%- endif -%}
        {%- if section.settings.gmp_text != blank -%}<p>{{ section.settings.gmp_text }}</p>{%- endif -%}
        {%- if section.settings.marketed_by_text != blank -%}<p class="myshake-footer__marketed">{{ section.settings.marketed_by_text }}</p>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <nav class="myshake-footer__menu" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} MID: custom left/right padding {%- endcomment -%}
  <div class="myshake-footer__mid">
    <div class="myshake-footer__logo">
      {%- if section.settings.logo_image != blank -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 700 }}"
          alt="{{ shop.name }}"
          loading="lazy"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
        >
      {%- else -%}
        <span class="myshake-footer__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    <div class="myshake-footer__divider" aria-hidden="true">
      <span class="myshake-footer__divider-dot"></span>
    </div>

    <div class="myshake-footer__tagline">
      {%- if section.settings.tagline_label != blank -%}
        <p class="myshake-footer__tagline-label">{{ section.settings.tagline_label }}</p>
      {%- endif -%}
      {%- if section.settings.tagline_text != blank -%}
        <p class="myshake-footer__tagline-text">{{ section.settings.tagline_text }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} BOTTOM: custom left/right padding {%- endcomment -%}
  <div class="myshake-footer__bottom">
    {%- if section.settings.copyright_text != blank -%}
      <p class="myshake-footer__copyright">{{ section.settings.copyright_text }}</p>
    {%- else -%}
      <p class="myshake-footer__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    {%- endif -%}

    {%- if section.settings.signature_text != blank -%}
      <p class="myshake-footer__signature">{{ section.settings.signature_text }}</p>
    {%- endif -%}
  </div>
</footer>

<style>
  #shopify-section-{{ section.id }} .myshake-footer,
  #shopify-section-{{ section.id }} .myshake-footer * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .myshake-footer {
    width: 100%;
    background: var(--mf-bg);
    color: var(--mf-text);
    padding: 40px 0 28px;
    overflow-x: hidden;
  }

  /* ===== TOP — page-width left/right ===== */
  #shopify-section-{{ section.id }} .myshake-footer__top {
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .myshake-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .myshake-footer__bolt {
    width: 40px;
    height: 40px;
    color: var(--mf-bolt);
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .myshake-footer__bolt img,
  #shopify-section-{{ section.id }} .myshake-footer__bolt svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .myshake-footer__social {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .myshake-footer__social a {
    display: flex;
    width: 26px;
    height: 26px;
    color: var(--mf-accent);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .myshake-footer__social svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .myshake-footer__legal p {
    margin: 0 0 4px;
    font-family: 'Inter', 'Poppins', sans-serif;
    font-weight: 400;
    font-size: clamp(12px, 1vw, 13px);
    line-height: 1.5;
    color: var(--mf-text);
  }

  #shopify-section-{{ section.id }} .myshake-footer__legal p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .myshake-footer__marketed {
    max-width: 180px;
    margin-top: 12px;
  }

  #shopify-section-{{ section.id }} .myshake-footer__menu h3 {
    margin: 0 0 16px;
    color: var(--mf-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .myshake-footer__menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .myshake-footer__menu a {
    color: var(--mf-text);
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .myshake-footer__menu a:hover {
    text-decoration: underline;
  }

  /* ===== MID — custom left/right padding ===== */
  #shopify-section-{{ section.id }} .myshake-footer__mid {
    width: 100%;
    margin-top: clamp(36px, 5vw, 56px);
    padding-left: var(--mf-mid-pad-l);
    padding-right: var(--mf-mid-pad-r);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .myshake-footer__logo {
    width: min(100%, 280px);
  }

  #shopify-section-{{ section.id }} .myshake-footer__logo img {
    width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .myshake-footer__logo-text {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 5vw, 48px);
    color: var(--mf-accent);
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .myshake-footer__divider {
    display: none;
  }

  #shopify-section-{{ section.id }} .myshake-footer__tagline {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .myshake-footer__tagline-label {
    margin: 0 0 8px;
    color: var(--mf-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: clamp(13px, 1.2vw, 16px);
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .myshake-footer__tagline-text {
    margin: 0;
    color: var(--mf-text);
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: clamp(13px, 1.15vw, 16px);
    line-height: 1.58;
  }

  /* ===== BOTTOM — custom left/right padding ===== */
  #shopify-section-{{ section.id }} .myshake-footer__bottom {
    width: 100%;
    margin-top: clamp(28px, 4vw, 40px);
    padding-top: 24px;
    padding-left: var(--mf-bot-pad-l);
    padding-right: var(--mf-bot-pad-r);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .myshake-footer__copyright {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-family: 'Inter', 'Poppins', sans-serif;
    font-weight: 400;
    font-size: clamp(12px, 1.1vw, 14px);
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .myshake-footer__signature {
    margin: 0;
    color: var(--mf-accent);
    font-family: 'Playwrite US Trad', 'Segoe Script', cursive;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 35px);
    line-height: 1.4;
    transform: rotate(-3deg);
  }

  /* Tablet+ */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .myshake-footer {
      padding: 48px 0 32px;
    }

    #shopify-section-{{ section.id }} .myshake-footer__top {
      grid-template-columns: minmax(180px, 1.1fr) repeat(3, minmax(0, 1fr));
      gap: clamp(32px, 5vw, 64px);
      align-items: start;
      padding-left: max(20px, 3vw);
      padding-right: max(20px, 3vw);
    }

    #shopify-section-{{ section.id }} .myshake-footer__mid {
      flex-direction: row;
      align-items: center;
      gap: clamp(28px, 4vw, 48px);
    }

    #shopify-section-{{ section.id }} .myshake-footer__logo {
      width: clamp(260px, 28vw, 400px);
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .myshake-footer__divider {
      display: flex;
      align-items: center;
      flex: 1 1 auto;
      min-width: 80px;
      max-width: 220px;
      height: 1px;
      background: var(--mf-accent);
      position: relative;
    }

    #shopify-section-{{ section.id }} .myshake-footer__divider-dot {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translate(50%, -50%);
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--mf-accent);
    }

    #shopify-section-{{ section.id }} .myshake-footer__tagline {
      flex: 0 1 430px;
      max-width: 430px;
    }

    #shopify-section-{{ section.id }} .myshake-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Mobile: keep usable custom padding floors */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .myshake-footer__mid {
      padding-left: max(20px, var(--mf-mid-pad-l));
      padding-right: max(20px, var(--mf-mid-pad-r));
    }

    #shopify-section-{{ section.id }} .myshake-footer__bottom {
      padding-left: max(20px, var(--mf-bot-pad-l));
      padding-right: max(20px, var(--mf-bot-pad-r));
    }

    #shopify-section-{{ section.id }} .myshake-footer__top {
      gap: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "MyShake Footer",
  "tag": "section",
  "class": "section-myshake-footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0B3B3D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (lime)",
      "default": "#A5ED64"
    },
    {
      "type": "color",
      "id": "bolt_color",
      "label": "Bolt color",
      "default": "#FF6B5B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Mid row custom padding"
    },
    {
      "type": "paragraph",
      "content": "Top row uses page-width. Mid + bottom use these custom left/right paddings."
    },
    {
      "type": "range",
      "id": "mid_padding_left",
      "label": "Mid left padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mid_padding_right",
      "label": "Mid right padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Bottom row custom padding"
    },
    {
      "type": "range",
      "id": "bottom_padding_left",
      "label": "Bottom left padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "bottom_padding_right",
      "label": "Bottom right padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Bolt icon"
    },
    {
      "type": "image_picker",
      "id": "bolt_icon",
      "label": "Bolt icon"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn"
    },
    {
      "type": "header",
      "content": "Legal text"
    },
    {
      "type": "text",
      "id": "fssai_text",
      "label": "FSSAI line",
      "default": "FSSAI: 10020051003483"
    },
    {
      "type": "text",
      "id": "gmp_text",
      "label": "GMP line",
      "default": "GMP Certified Facility"
    },
    {
      "type": "textarea",
      "id": "marketed_by_text",
      "label": "Marketed by line",
      "default": "Marketed by Global Healthfit Retail India Pvt. Ltd."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Footer logo"
    },
    {
      "type": "header",
      "content": "Tagline block"
    },
    {
      "type": "text",
      "id": "tagline_label",
      "label": "Tagline label",
      "default": "BUILT FOR PERFORMANCE"
    },
    {
      "type": "textarea",
      "id": "tagline_text",
      "label": "Tagline text",
      "default": "Designed for people who want to move better, train harder and perform at their best, MyShake brings a fresh perspective to sports nutrition: one built for performance, not just bodybuilding."
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2025–26 MyShake. All rights reserved."
    },
    {
      "type": "text",
      "id": "signature_text",
      "label": "Signature text",
      "default": "live to perform."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MyShake Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Explore" } },
        { "type": "menu", "settings": { "heading": "Resources" } }
      ]
    }
  ]
}
{% endschema %}
